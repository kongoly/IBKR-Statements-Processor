# ============================================================
# .gitignore — IBKR Statement Processor
# ============================================================
# Files and folders listed here will NEVER be uploaded to
# GitHub, even if you drag the entire project folder.
# ============================================================

# ── YOUR FINANCIAL DATA ──
# The SQLite database contains all your imported IBKR
# statements — real account values, trades, cash balances.
# Never upload this.
data/

# ── TEMP UPLOAD FOLDER ──
# CSV files are temporarily stored here during upload,
# then deleted immediately after parsing.
uploads/

# ── NODE PACKAGES ──
# This folder is huge (50MB+) and not needed on GitHub.
# Anyone who clones the repo just runs "npm install"
# and it gets recreated automatically.
node_modules/

# ── GOOGLE SHEETS CREDENTIALS (Phase 3) ──
# Your Google Service Account private key.
# If this leaks, someone can access your Google account.
# Never upload this under any circumstances.
credentials.json

# ── ENVIRONMENT VARIABLES ──
# If you ever store API keys or secrets in a .env file,
# this makes sure they never get uploaded.
.env
.env.local
.env.production

# ── WINDOWS SYSTEM FILES ──
# Auto-generated by Windows, not needed in the repo.
Thumbs.db
desktop.ini

# ── MACOS SYSTEM FILES ──
# Auto-generated by macOS if you ever open the folder there.
.DS_Store

# ── VSCODE SETTINGS ──
# Your personal editor settings — optional to exclude,
# but generally cleaner to keep out of the repo.
.vscode/